{
  "name": "media-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev:web": "npm run build:web && node --experimental-strip-types scripts/serve.ts",
    "build:web": "node --experimental-strip-types scripts/build-web.ts && tsc -p tsconfig.web.json --noCheck",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:source-language": "node --experimental-strip-types scripts/check-source-language.ts",
    "verify:web": "npm run check:source-language && npm run test && npm run build:web",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2"
  }
}
